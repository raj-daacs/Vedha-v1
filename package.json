{
  "name": "vedha-proto",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clickable prototype for Vedha — a decision-intelligence layer for B2B SaaS operators. No backend, no database, no auth; illustrative data only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "check:recipes": "esbuild scripts/checkResolve.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-recipes.mjs --log-level=warning && node node_modules/.cache/check-recipes.mjs",
    "check:definitions": "esbuild scripts/checkDefinitions.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-definitions.mjs --log-level=warning && node node_modules/.cache/check-definitions.mjs",
    "check": "npm run check:recipes && npm run check:definitions"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
